# Pro Wrestling Researcher — environment variables
# Copy to `.env` and fill in. `.env` is gitignored.

# Postgres connection. Either set DATABASE_URL outright, or set the PWBIB_PG_*
# pieces and the app will assemble it. Defaults: localhost:5432, db
# `wrestling_bibliography`, OS user.
# DATABASE_URL=postgresql://user@localhost:5432/wrestling_bibliography
# PWBIB_PG_HOST=localhost
# PWBIB_PG_PORT=5432
# PWBIB_PG_DB=wrestling_bibliography
# PWBIB_PG_USER=

# Flask app
PWBIB_HOST=127.0.0.1
PWBIB_PORT=5050
PWBIB_SECRET=change-me-for-real-deployments
# PWBIB_DEBUG=1

# Cover-image lookups (optional). Without it, falls back to Open Library only.
GOOGLE_API_TOKEN=

# Used by ingest scripts in bibliography/ and magazine_downloader/.
EXA_API_KEY=
CAGEMATCH_USER=
CAGEMATCH_PASSWORD=
