<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
        "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.gwp.wrestling-researcher</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>-lc</string>
        <string>cd '/Users/jschairb-gwp/src/ProWrestling Researcher' &amp;&amp; exec /usr/bin/python3 app/app.py --host 127.0.0.1 --port 5150 --debug</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/jschairb-gwp/src/ProWrestling Researcher</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/tmp/wrestling-researcher.out.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/wrestling-researcher.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PWBIB_HOST</key>
        <string>127.0.0.1</string>
        <key>PWBIB_PORT</key>
        <string>5150</string>
        <key>PWBIB_DEBUG</key>
        <string>1</string>
    </dict>
</dict>
</plist>
